# Cabeçalhos do Netlify.
# Imagens, fontes, CSS e JS têm nome estável e podem ficar no cache do
# visitante por um ano. O HTML precisa ser sempre revalidado, senão uma
# alteração publicada demora a aparecer.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
