# Cabeçalhos do Netlify.
# Fontes e biblioteca de animação: arquivos fechados, um ano de cache.
# CSS, JS do site, HTML e imagens: nome estável, conteúdo muda; revalidar.

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/brand/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate

/js/main.js
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
