# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/
*.swp

# Node, caso alguma ferramenta seja adicionada depois
node_modules/
npm-debug.log*

# Saída intermediária do preparo de imagens
tools/source/*-restaurada.png
fratelli-moveis-netlify.zip

# Cache do Python nas ferramentas
__pycache__/

# Versão de arquivo único (gerada por tools/build-single-file.py)
fratelli-moveis-visualizacao.html

# Visualização em arquivo único da GRO (gerada por gro-cascavel/tools/gerar-visualizacao.py)
gro-cascavel/visualizacao/

# Originais das fotos da GRO (pesados); o site usa as versões geradas em assets/images/fotos/
gro-cascavel/fotos-originais/*
!gro-cascavel/fotos-originais/LEIA.md

# V2 da GRO: visualização e pacote de entrega são gerados por tools/
gro-cascavel-v2/visualizacao/
gro-cascavel-v2/entrega/
gro-cascavel-v2/fotos-originais/*
!gro-cascavel-v2/fotos-originais/LEIA.md
